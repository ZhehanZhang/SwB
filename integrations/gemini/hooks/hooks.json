{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook gemini; exit 0'", "timeout": 1000 }]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook gemini; exit 0'", "timeout": 1000 }]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook gemini; exit 0'", "timeout": 1000 }]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook gemini; exit 0'", "timeout": 1000 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook gemini; exit 0'", "timeout": 1000 }]
      }
    ]
  }
