      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook codex; exit 0'", "timeout": 1 }]
      }
