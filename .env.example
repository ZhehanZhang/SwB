# Copy to .env (chmod 600). Values are secrets: type them yourself, never commit them.
# Container env is read at creation: after editing, run docker compose up -d (not just restart).

# Capy API key (Settings -> API), the principal delegated work runs as. Unset = offload tools off.
CAPY_API_KEY=

# Password for the OAuth consent page (Claude / ChatGPT sign-in). >= 16 chars recommended.
CAPY_BRIDGE_OWNER_PASSWORD=

# Static bearer keys for non-OAuth clients, one per client, >= 24 chars (openssl rand -hex 32).
# The part after CAPY_BRIDGE_KEY_ becomes the source tag (CAPY_BRIDGE_KEY_CAPY -> "capy").
CAPY_BRIDGE_KEY_CAPY=

# Cloudflare tunnel connector token (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# Optional: host port / bind address
# CAPY_BRIDGE_PORT=8870
# CAPY_BRIDGE_BIND=127.0.0.1
