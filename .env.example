# Copy to .env (chmod 600). Values are secrets: type them yourself, never commit them.
# Container env is read at creation: after editing, run docker compose up -d (not just restart).

# Capy API key (Settings -> API), the principal delegated work runs as. Unset = the capy destination is off.
CAPY_API_KEY=
# Optional: a Capy service user's key that sends messages and starts threads (destinations.capy.send_key_env).
# CAPY_API_KEY_SERVICE=

# Bearer keys for clients without OAuth, one per client, >= 24 chars (openssl rand -hex 32).
# The part after SWITCHBOARD_KEY_ becomes the agent name used by routes and the inbox
# (SWITCHBOARD_KEY_CAPY -> "capy", SWITCHBOARD_KEY_CHANNEL -> "channel" for the Claude Code channel).
SWITCHBOARD_KEY_CAPY=

# Cloudflare tunnel connector token (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# Optional: host port / bind address
# SWITCHBOARD_PORT=8870
# SWITCHBOARD_BIND=127.0.0.1
