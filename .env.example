# Copy this file to .env. Set file mode 600. Keep the file private.
# Run docker compose up -d to apply your changes.

# Use bearer keys as an alternative to OAuth. Use at least 24 characters per key.
# See the README to generate a key. Routes and the inbox use the name after SWB_KEY_.
# SWB_KEY_OWNER=
# SWB_KEY_CAPY=
# SWB_KEY_CHANNEL=

# Optional instance settings. A base YAML file and private overlay can override settings below.
# SWB_PUBLIC_URL=https://swb.example.com
# SWB_DATA_DIR=/data
# SWB_HOST=127.0.0.1
# SWB_CONFIG=/config/switchboard.yaml
# SWB_OVERLAY=/config/local.yaml
# SWB_TRUSTED_PROXIES=
# SWB_OWNER_EMAILS=owner@example.com,admin@example.com
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=<TEAM_NAME>.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=

# Use a personal key to read from Capy. Use a service key to send from a service account.
# CAPY_API_KEY=
# CAPY_API_KEY_SERVICE=

# Configure GitHub destinations and routes in YAML.
# GITHUB_WEBHOOK_SECRET=
# TEAM_GITHUB_SINK_URL=

# Set a team ID and a bot or user token for Slack. Use an app token for Socket Mode.
# Use names such as SLACK_SUPPORT_BOT_TOKEN and SLACK_SUPPORT_TEAM_ID for more workspaces.
# SLACK_TEAM_ID=
# SLACK_BOT_TOKEN=
# SLACK_USER_TOKEN=
# SLACK_APP_TOKEN=

# Set a bot token to connect Discord or Telegram. Configure routing and access in YAML.
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Add the same _<NAME> to both variables for a named Claude Code routine.
# CLAUDE_ROUTINE_ID=
# CLAUDE_ROUTINE_TOKEN=

# Use GROK_ROUTINE_<NAME>_URL and GROK_ROUTINE_<NAME>_SECRET for a named Grok Bot routine.
# GROK_ROUTINE_URL=
# GROK_ROUTINE_SECRET=

# Set a Cloudflare Tunnel token. Run docker compose --profile tunnel up -d.
# TUNNEL_TOKEN=

# Configure the Compose host port. Set the bind address and the container user ID as needed.
# SWB_PORT=8870
# SWB_BIND=127.0.0.1
# SWB_UID=10001
