# SwB: Copy to .env (mode 600). Fill in only what you use. Never commit this private file.
# After edits, run docker compose up -d to apply the new environment.

# Bearer keys for clients without OAuth, at least 24 characters. See the README for private key generation.
# The SWITCHBOARD_KEY_<NAME> suffix becomes the client agent name used by routes and the inbox.
# SWITCHBOARD_KEY_OWNER=
# SWITCHBOARD_KEY_CAPY=
# SWITCHBOARD_KEY_CHANNEL=

# Optional instance settings. A base YAML file and private overlay can override settings below.
# PUBLIC_URL=https://switchboard.example.com
# SWITCHBOARD_DATA_DIR=/data
# SWITCHBOARD_CONFIG=/config/switchboard.yaml
# SWITCHBOARD_OVERLAY=/config/local.yaml
# SWITCHBOARD_OWNER_EMAILS=owner@example.com,admin@example.com
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=<TEAM_NAME>.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=

# Capy: personal key for reads; optional service key for sends.
# CAPY_API_KEY=
# CAPY_API_KEY_SERVICE=

# GitHub webhooks: configure sinks and routes in YAML.
# GITHUB_WEBHOOK_SECRET=
# TEAM_GITHUB_SINK_URL=

# Slack: bot or user token plus team ID. The app token enables Socket Mode.
# For additional workspaces use names such as SLACK_SUPPORT_BOT_TOKEN and SLACK_SUPPORT_TEAM_ID.
# SLACK_TEAM_ID=
# SLACK_BOT_TOKEN=
# SLACK_USER_TOKEN=
# SLACK_APP_TOKEN=

# Discord and Telegram: set the token to enable the block. Configure routing and grants in YAML.
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Claude Code routine: for named routines append the same _<NAME> to both variables.
# CLAUDE_ROUTINE_ID=
# CLAUDE_ROUTINE_TOKEN=

# Grok Bot routine: for named routines use GROK_ROUTINE_<NAME>_URL and GROK_ROUTINE_<NAME>_SECRET.
# GROK_ROUTINE_URL=
# GROK_ROUTINE_SECRET=

# Optional Cloudflare Tunnel connector token (docker compose --profile tunnel up -d).
# TUNNEL_TOKEN=

# Optional Compose settings: host port, bind address and container user UID.
# SWITCHBOARD_PORT=8870
# SWITCHBOARD_BIND=127.0.0.1
# SWITCHBOARD_UID=10001
