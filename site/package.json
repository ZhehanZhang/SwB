{
  "name": "swb-site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env local --local",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env= && node scripts/smoke-deploy.mjs",
    "smoke": "node scripts/smoke-deploy.mjs",
    "check:style": "node scripts/check-style.mjs",
    "check:cjk": "node scripts/check-cjk.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/inter-tight": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fumadocs/ai-chat": "0.1.4",
    "@fumadocs/language": "0.2.21",
    "@opennextjs/cloudflare": "1.20.19",
    "ai": "^7.0.183",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.0.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-cjk-friendly": "^2.3.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "github-slugger": "2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  }
}
