{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1 }]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1, "async": true }]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1 }]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input|idle_prompt",
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1 }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "sh -c 'test -S \"${SWB_COMPANION_HOME:-$HOME/.config/swb}/hooks.sock\" && swb hook claude-code; exit 0'", "timeout": 1 }]
      }
    ]
  }
}
